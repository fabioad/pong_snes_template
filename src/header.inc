; LoROM NTSC, 32 KiB, ROM only, no SRAM, SlowROM.
; Memory map and cartridge header for WLA-DX.

.MEMORYMAP
    SLOTSIZE $8000
    DEFAULTSLOT 0
    SLOT 0 $8000
.ENDME

.ROMBANKSIZE $8000
.ROMBANKS 1

.SNESHEADER
    ID "SNES"
    NAME "PONG TEMPLATE        "
    ;    "123456789012345678901"
    SLOWROM
    LOROM
    CARTRIDGETYPE $00
    ROMSIZE $05
    SRAMSIZE $00
    COUNTRY $01
    LICENSEECODE $00
    VERSION $00
.ENDSNES

.EMPTYFILL $00
